\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Respuestas del sistema ante la variación de los polos. Para polos reales y negativos la respuesta es totalmente sobreamortiguada, no existe un sobrepaso. Cuando los polos son complejos conjugados existe un sobrepaso en la respuesta. A medida que la parte imaginaria se hace más grande en magnitud, más grande es el sobrepaso.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:3}{{3}{4}{Respuestas del sistema ante la variación de los polos. Para polos reales y negativos la respuesta es totalmente sobreamortiguada, no existe un sobrepaso. Cuando los polos son complejos conjugados existe un sobrepaso en la respuesta. A medida que la parte imaginaria se hace más grande en magnitud, más grande es el sobrepaso}{figure.caption.3}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Características del sistema ante la respuesta escalón. El \texttt  {RiseTime} es el tiempo que tarda la respuesta en subir del $10\%$ al $90\%$. El \texttt  {TransientTime} es el primer tiempo tal que el error está por debajo del $2\%$. Las demás características se pueden deducir fácilmente.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:4}{{4}{5}{Características del sistema ante la respuesta escalón. El \texttt {RiseTime} es el tiempo que tarda la respuesta en subir del $10\%$ al $90\%$. El \texttt {TransientTime} es el primer tiempo tal que el error está por debajo del $2\%$. Las demás características se pueden deducir fácilmente}{figure.caption.4}{}}
