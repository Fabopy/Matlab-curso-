\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sistema de segundo orden con factores de amortiguamiento variables. Si $0< \zeta < 1$, entonces el sistema es \textbf  {subamortiguado} y presentará algún sobrepaso o sobreenlongación. Si $\zeta > 1$, el sistema es \textbf  {sobreamortiguado} y no presentará sobrepaso. Si $\zeta = 0$, entonces el sistema es oscilante y nunca se amortiguará. Si $\zeta < 0$, el sistema está en un equilibrio inestable y diverge (no tiene sentido hablar sobre factores de amortiguamiento negativos).}}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:2}{{2}{5}{Sistema de segundo orden con factores de amortiguamiento variables. Si $0< \zeta < 1$, entonces el sistema es \textbf {subamortiguado} y presentará algún sobrepaso o sobreenlongación. Si $\zeta > 1$, el sistema es \textbf {sobreamortiguado} y no presentará sobrepaso. Si $\zeta = 0$, entonces el sistema es oscilante y nunca se amortiguará. Si $\zeta < 0$, el sistema está en un equilibrio inestable y diverge (no tiene sentido hablar sobre factores de amortiguamiento negativos)}{figure.caption.2}{}}
